{
  "name": "TaskGroup",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "retailer": {
      "type": "string",
      "description": "Retailer tag for grouping e.g. Walmart, PokemonCenter \u2014 used to batch-assign to monitors"
    },
    "target_url": {
      "type": "string"
    },
    "instance_count": {
      "type": "number",
      "default": 5
    },
    "delay_ms": {
      "type": "number",
      "default": 0,
      "description": "Delay between each instance launch in milliseconds"
    },
    "proxy_group_id": {
      "type": "string",
      "description": "ID of the ProxyGroup to use"
    },
    "proxy_group_name": {
      "type": "string",
      "description": "Cached name for display"
    },
    "session_profile_id": {
      "type": "string",
      "description": "ID of a SessionProfile to use for launch args"
    },
    "user_agent": {
      "type": "string"
    },
    "browser": {
      "type": "string",
      "enum": [
        "chrome",
        "brave"
      ],
      "default": "chrome"
    },
    "rotation_mode": {
      "type": "string",
      "enum": [
        "round_robin",
        "random",
        "sticky"
      ],
      "default": "round_robin"
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time",
      "description": "Schedule a future launch time (ISO)"
    },
    "webhook_url": {
      "type": "string",
      "description": "Discord webhook URL to POST on trigger"
    },
    "warmup_minutes": {
      "type": "number",
      "default": 0,
      "description": "Open target site N minutes before scheduled launch, then reload on trigger"
    }
  },
  "required": [
    "name",
    "target_url"
  ]
}