{
  "name": "BrowserSession",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Session display name"
    },
    "target_url": {
      "type": "string",
      "description": "URL to open in the browser"
    },
    "proxy_id": {
      "type": "string",
      "description": "ID of the proxy assigned to this session"
    },
    "proxy_label": {
      "type": "string",
      "description": "Display label showing which proxy is in use"
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "stopped",
        "error"
      ],
      "default": "running"
    },
    "browser": {
      "type": "string",
      "enum": [
        "chrome",
        "brave"
      ],
      "default": "chrome",
      "description": "Which browser to spawn"
    },
    "rotation_mode": {
      "type": "string",
      "enum": [
        "sticky",
        "round_robin",
        "random"
      ],
      "default": "round_robin"
    },
    "queue_timer_ms": {
      "type": "number",
      "description": "Current queue wait time in milliseconds \u2014 lower is better"
    },
    "queue_position": {
      "type": "number",
      "description": "Current position in the retailer queue"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "stopped_at": {
      "type": "string",
      "format": "date-time"
    },
    "user_agent": {
      "type": "string",
      "description": "Custom user agent string"
    },
    "walmart_account_id": {
      "type": "string",
      "description": "WalmartAccount this login session was launched for (used by IMAP code-auto-fill matching)"
    },
    "walmart_account_email": {
      "type": "string",
      "description": "Cached email of the WalmartAccount this session targets"
    }
  },
  "required": [
    "name",
    "target_url"
  ]
}