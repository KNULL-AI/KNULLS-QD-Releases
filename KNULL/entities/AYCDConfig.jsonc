{
  "name": "AYCDConfig",
  "type": "object",
  "properties": {
    "api_key": {
      "type": "string",
      "description": "AYCD AutoSolve API Key"
    },
    "is_connected": {
      "type": "boolean",
      "default": false
    },
    "label": {
      "type": "string",
      "default": "default"
    },
    "poll_tier": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium",
      "description": "Captcha poll frequency tier: low=1-10 instances (800ms), medium=10-50 (1200ms), high=50-100 (1800ms)"
    }
  },
  "required": [
    "api_key"
  ]
}