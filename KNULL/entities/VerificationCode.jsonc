{
  "name": "VerificationCode",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Extracted numeric verification code"
    },
    "to_email": {
      "type": "string",
      "description": "Recipient address parsed from the email To header (used to match a WalmartAccount)"
    },
    "from_email": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "snippet": {
      "type": "string",
      "description": "First ~200 chars of the email body for context"
    },
    "account_id": {
      "type": "string",
      "description": "Matched WalmartAccount ID (null if none matched)"
    },
    "session_id": {
      "type": "string",
      "description": "Session the code was auto-injected into, if any"
    },
    "delivery_status": {
      "type": "string",
      "enum": [
        "auto_filled",
        "displayed",
        "no_account",
        "no_session"
      ],
      "default": "displayed"
    },
    "message_uid": {
      "type": "string",
      "description": "IMAP UID used to prevent re-processing the same email across poll cycles"
    }
  },
  "required": [
    "code",
    "to_email"
  ]
}