{
  "name": "ActivityEvent",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "session_launched",
        "session_stopped",
        "session_crashed",
        "proxy_swapped",
        "discord_trigger",
        "task_group_run",
        "proxy_healthy",
        "proxy_unhealthy"
      ]
    },
    "message": {
      "type": "string"
    },
    "meta": {
      "type": "string",
      "description": "JSON string with extra context"
    }
  },
  "required": [
    "type",
    "message"
  ]
}