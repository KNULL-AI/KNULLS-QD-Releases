{
  "name": "SystemLog",
  "type": "object",
  "properties": {
    "level": {
      "type": "string",
      "enum": [
        "info",
        "warn",
        "error",
        "crash"
      ],
      "default": "info"
    },
    "source": {
      "type": "string",
      "description": "Where the log originated e.g. Sessions, ProxyCheck, DiscordMonitor"
    },
    "message": {
      "type": "string"
    },
    "details": {
      "type": "string",
      "description": "Stack trace or extra context"
    }
  },
  "required": [
    "level",
    "source",
    "message"
  ]
}