{
  "name": "Proxy",
  "type": "object",
  "properties": {
    "host": {
      "type": "string",
      "description": "Proxy IP or hostname"
    },
    "port": {
      "type": "number",
      "description": "Proxy port number"
    },
    "protocol": {
      "type": "string",
      "enum": [
        "HTTP",
        "HTTPS",
        "SOCKS4",
        "SOCKS5"
      ],
      "default": "HTTP"
    },
    "username": {
      "type": "string",
      "description": "Auth username (optional)"
    },
    "password": {
      "type": "string",
      "description": "Auth password (optional)"
    },
    "label": {
      "type": "string",
      "description": "Friendly label for this proxy"
    },
    "status": {
      "type": "string",
      "enum": [
        "untested",
        "healthy",
        "unhealthy"
      ],
      "default": "untested"
    },
    "response_time_ms": {
      "type": "number",
      "description": "Last measured response time in ms"
    },
    "last_checked": {
      "type": "string",
      "format": "date-time",
      "description": "When the proxy was last health-checked"
    },
    "country": {
      "type": "string",
      "description": "Geo location / country code"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether proxy is in the active rotation pool"
    },
    "fail_count": {
      "type": "number",
      "default": 0,
      "description": "Consecutive failures"
    }
  },
  "required": [
    "host",
    "port"
  ]
}