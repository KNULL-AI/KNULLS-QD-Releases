{
  "name": "WalmartDrop",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Friendly name e.g. Pokemon Cards Drop"
    },
    "drop_time_of_day": {
      "type": "string",
      "description": "Drop time as HH:MM (24h) \u2014 e.g. '21:00' for 9pm"
    },
    "schedule_days": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Optional days of week to auto-fire (0=Sun \u2026 6=Sat). Empty = manual only."
    },
    "product_url": {
      "type": "string",
      "description": "Walmart product URL to navigate all sessions to 10 minutes before drop"
    },
    "account_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "WalmartAccount IDs assigned to this drop"
    },
    "proxy_group_id": {
      "type": "string",
      "description": "Optional fallback proxy group if accounts have no proxy"
    },
    "status": {
      "type": "string",
      "enum": [
        "idle",
        "warming",
        "live",
        "done",
        "cancelled"
      ],
      "default": "idle",
      "description": "Current phase of the drop lifecycle"
    },
    "session_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "BrowserSession IDs launched for this drop"
    },
    "warmup_fired_at": {
      "type": "string",
      "format": "date-time"
    },
    "url_fired_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "name",
    "drop_time_of_day",
    "product_url"
  ]
}